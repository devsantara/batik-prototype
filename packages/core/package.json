{
  "name": "@batik-prototype/core",
  "version": "0.3.0",
  "description": "Themeable StyleX components and the design token contract every Batik theme overrides",
  "keywords": [
    "components",
    "design system",
    "design tokens",
    "react",
    "stylex",
    "theming"
  ],
  "homepage": "https://github.com/devsantara/batik-prototype/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/devsantara/batik-prototype/issues"
  },
  "license": "MIT",
  "author": "devsantara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantara/batik-prototype.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./tokens/breakpoint.stylex": "./src/tokens/breakpoint.stylex.ts",
    "./tokens/color.stylex": "./src/tokens/color.stylex.ts",
    "./tokens/font.stylex": "./src/tokens/font.stylex.ts",
    "./tokens/shape.stylex": "./src/tokens/shape.stylex.ts",
    "./tokens/space.stylex": "./src/tokens/space.stylex.ts",
    "./tokens/switch.stylex": "./src/tokens/switch.stylex.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./theme": "./dist/theme/index.js",
      "./tokens/breakpoint.stylex": "./dist/tokens/breakpoint.stylex.js",
      "./tokens/color.stylex": "./dist/tokens/color.stylex.js",
      "./tokens/font.stylex": "./dist/tokens/font.stylex.js",
      "./tokens/shape.stylex": "./dist/tokens/shape.stylex.js",
      "./tokens/space.stylex": "./dist/tokens/space.stylex.js",
      "./tokens/switch.stylex": "./dist/tokens/switch.stylex.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "devDependencies": {
    "@batik-prototype/config": "workspace:*",
    "@stylexjs/stylex": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "react": ">=19"
  }
}
