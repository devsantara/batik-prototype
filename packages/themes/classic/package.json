{
  "name": "@batik-prototype/theme-classic",
  "version": "0.2.0",
  "description": "Cool slate neutrals, a confident blue accent and small rounded corners, in light and dark",
  "keywords": [
    "classic",
    "design system",
    "design tokens",
    "stylex",
    "theme"
  ],
  "homepage": "https://github.com/devsantara/batik-prototype/tree/main/packages/themes/classic#readme",
  "bugs": {
    "url": "https://github.com/devsantara/batik-prototype/issues"
  },
  "license": "MIT",
  "author": "devsantara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantara/batik-prototype.git",
    "directory": "packages/themes/classic"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "devDependencies": {
    "@batik-prototype/config": "workspace:*",
    "@batik-prototype/core": "workspace:*"
  },
  "peerDependencies": {
    "@batik-prototype/core": "workspace:^"
  }
}
