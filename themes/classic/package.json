{
  "name": "@batik-prototype/theme-classic",
  "version": "0.0.0",
  "description": "The default Batik theme: cool slate neutrals with a confident blue accent, plus a dark scheme",
  "keywords": [
    "classic",
    "design system",
    "design tokens",
    "stylex",
    "theme"
  ],
  "homepage": "https://github.com/devsantara/batik-prototype/tree/main/themes/classic#readme",
  "bugs": {
    "url": "https://github.com/devsantara/batik-prototype/issues"
  },
  "license": "MIT",
  "author": "devsantara",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devsantara/batik-prototype.git",
    "directory": "themes/classic"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "devDependencies": {
    "@batik-prototype/config": "workspace:*",
    "@batik-prototype/core": "workspace:*",
    "@stylexjs/stylex": "catalog:"
  },
  "peerDependencies": {
    "@batik-prototype/core": "workspace:^",
    "@stylexjs/stylex": "^0.19.0"
  }
}
